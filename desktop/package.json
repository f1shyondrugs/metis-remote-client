{
  "name": "metis-ai-remote-client",
  "version": "1.4.4",
  "private": true,
  "description": "Metis AI Remote Client Hub",
  "main": "main.cjs",
  "author": "f1shyondrugs",
  "license": "MIT",
  "scripts": {
    "prepare:client": "node prepare-client.cjs",
    "start": "npm run prepare:client && electron .",
    "build:win": "npm run prepare:client && electron-builder --win nsis --x64",
    "build:mac": "npm run prepare:client && electron-builder --mac dmg --arm64",
    "build:linux": "npm run prepare:client && electron-builder --linux AppImage --x64",
    "build:dir": "npm run prepare:client && electron-builder --dir"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "koffi": "^2.16.3",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ai.metis.remoteclient",
    "productName": "Metis AI Remote Client",
    "asar": true,
    "asarUnpack": [
      "computer-use-worker.mjs",
      "computer-use.mjs",
      "computer-use-unix.mjs",
      "libmetisdesktop.dylib",
      "**/node_modules/koffi/**"
    ],
    "files": [
      "main.cjs",
      "preload.cjs",
      "index.html",
      "renderer.js",
      "styles.css",
      "client.mjs",
      "computer-use.mjs",
      "computer-use-worker.mjs",
      "computer-use-unix.mjs",
      "computer-use-overlay.cjs",
      "libmetisdesktop.dylib",
      "assets/icon.ico",
      "assets/icon.png",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "executableName": "Metis AI Remote Client"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/uninstall.nsh",
      "artifactName": "Metis-AI-Remote-Client-Setup.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.utilities",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "artifactName": "Metis-AI-Remote-Client-${arch}.dmg"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Utility",
      "artifactName": "Metis-AI-Remote-Client-x86_64.AppImage"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "f1shyondrugs",
        "repo": "metis-remote-client"
      }
    ]
  }
}
